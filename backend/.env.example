# PredictaStock Environment Configuration
# Optional: Add any of the following LLM API keys to enable real-time LLM multi-agent debates.
# If left blank, the system automatically runs the high-speed Quantitative Rule Engine with zero cost.

# Google Gemini API Key (Recommended - Free Tier available: https://aistudio.google.com)
GEMINI_API_KEY=

# Groq API Key (Ultra-fast Llama-3.3-70B inference: https://console.groq.com)
GROQ_API_KEY=

# OpenAI API Key (GPT-4o / GPT-4o-mini: https://platform.openai.com)
OPENAI_API_KEY=
